# Copia este archivo como .env y ajusta los valores (12-Factor: la configuración vive en el entorno).
DATABASE_URL=sqlite:///./sazon_urbano.db
# Con Docker Compose se usa PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://sazon:sazon_dev@db:5432/sazon_urbano
SEED_ON_START=true
APP_TIMEZONE=America/Monterrey
APP_ENV=development
# Si se define, toda petición debe enviar el encabezado X-API-Key
API_KEY=
DATA_DIR=data
POSTGRES_USER=sazon
POSTGRES_PASSWORD=sazon_dev
POSTGRES_DB=sazon_urbano
PORT=8000

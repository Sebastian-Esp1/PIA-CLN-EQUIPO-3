<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs" targetNamespace="http://sazon-urbano/bpmn">
<collaboration id="col"><participant id="part" name="Sazón Urbano (TO-BE)" processRef="proc"/></collaboration>
<process id="proc" isExecutable="false"><laneSet id="ls">
<lane id="lane0" name="Mesero / Caja"><flowNodeRef>ini</flowNodeRef><flowNodeRef>t1</flowNodeRef><flowNodeRef>t2</flowNodeRef><flowNodeRef>t4</flowNodeRef><flowNodeRef>fin</flowNodeRef></lane>
<lane id="lane1" name="Sistema (API)"><flowNodeRef>g1</flowNodeRef><flowNodeRef>t3</flowNodeRef><flowNodeRef>t5</flowNodeRef><flowNodeRef>t7</flowNodeRef></lane>
<lane id="lane2" name="Cocina"><flowNodeRef>t6</flowNodeRef><flowNodeRef>g2</flowNodeRef></lane>
<lane id="lane3" name="Encargado"><flowNodeRef>t8</flowNodeRef><flowNodeRef>fin2</flowNodeRef></lane>
</laneSet>
<startEvent id="ini" name="Llega pedido"><outgoing>f_ini_t1</outgoing></startEvent>
<task id="t1" name="Iniciar pedido (canal, cliente)"><incoming>f_ini_t1</incoming><outgoing>f_t1_t2</outgoing></task>
<task id="t2" name="Agregar producto y modificaciones"><incoming>f_t1_t2</incoming><incoming>f_t3_t2</incoming><outgoing>f_t2_g1</outgoing></task>
<exclusiveGateway id="g1" name="¿Producto disponible?"><incoming>f_t2_g1</incoming><outgoing>f_g1_t3</outgoing><outgoing>f_g1_t4</outgoing></exclusiveGateway>
<task id="t3" name="Registrar incidencia y avisar"><incoming>f_g1_t3</incoming><outgoing>f_t3_t2</outgoing></task>
<task id="t4" name="Autorizar y confirmar pedido"><incoming>f_g1_t4</incoming><outgoing>f_t4_t5</outgoing><outgoing>f_t4_t8</outgoing></task>
<task id="t5" name="Validar R1, descontar insumos (1 transacción)"><incoming>f_t4_t5</incoming><outgoing>f_t5_t6</outgoing></task>
<task id="t6" name="Preparar líneas por estación"><incoming>f_t5_t6</incoming><incoming>f_g2_t6</incoming><outgoing>f_t6_g2</outgoing></task>
<exclusiveGateway id="g2" name="¿Todas las líneas listas?"><incoming>f_t6_g2</incoming><outgoing>f_g2_t6</outgoing><outgoing>f_g2_t7</outgoing></exclusiveGateway>
<task id="t7" name="Cerrar pedido y registrar venta"><incoming>f_g2_t7</incoming><outgoing>f_t7_fin</outgoing></task>
<endEvent id="fin" name="Pedido entregado"><incoming>f_t7_fin</incoming></endEvent>
<task id="t8" name="Cancelar con motivo (si aplica)"><incoming>f_t4_t8</incoming><outgoing>f_t8_fin2</outgoing></task>
<endEvent id="fin2" name="Pedido cancelado"><incoming>f_t8_fin2</incoming></endEvent>
<sequenceFlow id="f_ini_t1" name="" sourceRef="ini" targetRef="t1"/>
<sequenceFlow id="f_t1_t2" name="" sourceRef="t1" targetRef="t2"/>
<sequenceFlow id="f_t2_g1" name="" sourceRef="t2" targetRef="g1"/>
<sequenceFlow id="f_g1_t3" name="No" sourceRef="g1" targetRef="t3"/>
<sequenceFlow id="f_t3_t2" name="corregir" sourceRef="t3" targetRef="t2"/>
<sequenceFlow id="f_g1_t4" name="Sí" sourceRef="g1" targetRef="t4"/>
<sequenceFlow id="f_t4_t5" name="" sourceRef="t4" targetRef="t5"/>
<sequenceFlow id="f_t5_t6" name="" sourceRef="t5" targetRef="t6"/>
<sequenceFlow id="f_t6_g2" name="" sourceRef="t6" targetRef="g2"/>
<sequenceFlow id="f_g2_t6" name="No" sourceRef="g2" targetRef="t6"/>
<sequenceFlow id="f_g2_t7" name="Sí" sourceRef="g2" targetRef="t7"/>
<sequenceFlow id="f_t7_fin" name="" sourceRef="t7" targetRef="fin"/>
<sequenceFlow id="f_t4_t8" name="cancelar" sourceRef="t4" targetRef="t8"/>
<sequenceFlow id="f_t8_fin2" name="" sourceRef="t8" targetRef="fin2"/>
</process><bpmndi:BPMNDiagram id="d"><bpmndi:BPMNPlane id="p" bpmnElement="col">
